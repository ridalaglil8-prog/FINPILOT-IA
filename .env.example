# ---------------------------------------------------------------------------
# FinPilot AI — environment template
# Copy to `.env` and fill in. NEVER commit the real `.env` file.
# The application runs fully in Demo mode WITHOUT any of these values.
# ---------------------------------------------------------------------------

# --- LLM assistant (OpenAI-compatible chat-completions endpoint) -----------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# --- Optional, explicit FX conversion --------------------------------------
# FinPilot AI refuses to mix USD and MAD unless a rate is provided here or
# entered by the user in Settings. Leave empty to keep totals per currency.
FX_USD_MAD=
FX_MAD_USD=

# --- Development ------------------------------------------------------------
# Set to 1 to show detailed technical errors in the UI (local debugging only).
FINPILOT_DEBUG=0
